&GLOBAL
	PROJECT Cu_slab
	RUN_TYPE ENERGY
	PREFERRED_FFT_LIBRARY FFTW3
	EXTENDED_FFT_LENGTHS True
&END GLOBAL
&FORCE_EVAL
	METHOD QS
	&DFT
		BASIS_SET_FILE_NAME BASIS_MOLOPT
		POTENTIAL_FILE_NAME GTH_POTENTIALS
		&MGRID
			CUTOFF 400
			REL_CUTOFF 60
		&END MGRID
		&SCF
			EPS_SCF 1e-06
			MAX_SCF 100
			ADDED_MOS 50
			&DIAGONALIZATION
				ALGORITHM STANDARD
			&END DIAGONALIZATION
			&MIXING
				METHOD BROYDEN_MIXING
				ALPHA 0.4
				NBROYDEN 8
			&END MIXING
			&SMEAR
				METHOD FERMI_DIRAC
				ELECTRONIC_TEMPERATURE [K] 2000
			&END SMEAR
		&END SCF
		&XC
			&XC_FUNCTIONAL PBE
			&END XC_FUNCTIONAL
		&END XC
	&END DFT
	&SUBSYS
		&CELL
			PERIODIC XYZ
		&END CELL
		&TOPOLOGY
			COORD_FILE_FORMAT XYZ
			COORD_FILE_NAME runs/slabs/slab_5.extxyz
		&END TOPOLOGY
		&KIND Cu
			BASIS_SET DZVP-MOLOPT-SR-GTH-q11
			POTENTIAL GTH-PBE-q11
		&END KIND
	&END SUBSYS
&END FORCE_EVAL
