
&GLOBAL
  PROJECT SiO2_quick_test
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL

    &MGRID
      CUTOFF 350
      REL_CUTOFF 40
    &END MGRID

    &QS
      METHOD GPW
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 60

      &OT
        MINIMIZER CG
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT

      &OUTER_SCF
        MAX_SCF 5
        EPS_SCF 1.0E-6
      &END OUTER_SCF
    &END SCF


    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC


    &POISSON
      PERIODIC XY
      POISSON_SOLVER ANALYTIC
    &END POISSON

    &PRINT
    &V_HARTREE_CUBE ON
      FILENAME hartree_potential
      STRIDE 1 1 1
    &END V_HARTREE_CUBE
      &MOMENTS ON 
            PERIODIC TRUE 
            MAX_MOMENT = 1 
            FILENAME dipole.dat 
            &EACH 
                QS_SCF 1 
            &END EACH 
        &END MOMENTS

  &END PRINT 

  &END DFT

  &SUBSYS
    &CELL
      @INCLUDE cell.inc
      PERIODIC XY
    &END CELL

    &TOPOLOGY
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME runs/slabs/slab.xyz
    &END TOPOLOGY

    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND

  &END SUBSYS
&END FORCE_EVAL

