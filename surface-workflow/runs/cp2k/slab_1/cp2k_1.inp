&GLOBAL
	RUN_TYPE ENERGY
	PRINT_LEVEL LOW
	PREFERRED_FFT_LIBRARY FFTW3
	EXTENDED_FFT_LENGTHS True
	PROJECT ads_slab_1_optimized
&END GLOBAL
&FORCE_EVAL
	METHOD QUICKSTEP
	&DFT
		BASIS_SET_FILE_NAME BASIS_MOLOPT
		POTENTIAL_FILE_NAME POTENTIAL
		&MGRID
			CUTOFF 350
			REL_CUTOFF 40
		&END MGRID
		&QS
			METHOD GPW
		&END QS
		&SCF
			SCF_GUESS ATOMIC
			EPS_SCF 1e-06
			MAX_SCF 100
			&OT
				MINIMIZER CG
				PRECONDITIONER FULL_SINGLE_INVERSE
			&END OT
			&OUTER_SCF
				MAX_SCF 10
				EPS_SCF 1e-06
			&END OUTER_SCF
		&END SCF
		&XC
			&XC_FUNCTIONAL PBE
			&END XC_FUNCTIONAL
		&END XC
		&POISSON
			PERIODIC XY
			POISSON_SOLVER ANALYTIC
		&END POISSON
	&END DFT
	&SUBSYS
		&CELL
			A [angstrom] 15.467898613059 0.0 0.0
			B [angstrom] -15.467898613059 15.467898613059 0.0
			C [angstrom] 0.0 0.0 43.749824
			PERIODIC XY
		&END CELL
		&TOPOLOGY
			COORD_FILE_FORMAT XYZ
			COORD_FILE_NAME ads_slab_1_optimized.extxyz
		&END TOPOLOGY
		&KIND Si
			BASIS_SET DZVP-MOLOPT-SR-GTH
			POTENTIAL GTH-PBE-q4
		&END KIND
		&KIND H
			BASIS_SET DZVP-MOLOPT-SR-GTH
			POTENTIAL GTH-PBE-q1
		&END KIND
		&KIND O
			BASIS_SET DZVP-MOLOPT-SR-GTH
			POTENTIAL GTH-PBE-q6
		&END KIND
		&KIND Al
			BASIS_SET DZVP-MOLOPT-SR-GTH
			POTENTIAL GTH-PBE-q3
		&END KIND
		&KIND C
			BASIS_SET DZVP-MOLOPT-SR-GTH
			POTENTIAL GTH-PBE-q4
		&END KIND
	&END SUBSYS
&END FORCE_EVAL
