&GLOBAL
	PROJECT SiO2_quick_test
	RUN_TYPE ENERGY
	PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
	METHOD QUICKSTEP
	&DFT
		BASIS_SET_FILE_NAME BASIS_MOLOPT
		POTENTIAL_FILE_NAME POTENTIAL
		&MGRID
			CUTOFF 250
			REL_CUTOFF 30
		&END MGRID
		&QS
			METHOD GPW
		&END QS
		&SCF
			SCF_GUESS ATOMIC
			EPS_SCF 1e-05
			MAX_SCF 40
			&OT
				MINIMIZER DIIS
				PRECONDITIONER FULL_SINGLE_INVERSE
			&END OT
		&END SCF
		&XC
			&XC_FUNCTIONAL PBE
			&END XC_FUNCTIONAL
		&END XC
		&POISSON
			PERIODIC None
			POISSON_SOLVER MT
		&END POISSON
	&END DFT
	&SUBSYS
		&CELL
			A [angstrom] 5.121237833306 0.0 0.0
			B [angstrom] -5.121237833306 5.121237833306 0.0
			C [angstrom] 0.0 0.0 39.833882
			PERIODIC XYZ
		&END CELL
		&TOPOLOGY
			COORD_FILE_FORMAT XYZ
			COORD_FILE_NAME slab_1.extxyz
		&END TOPOLOGY
		&KIND Si
			BASIS_SET DZVP-MOLOPT-SR-GTH
			POTENTIAL GTH-PBE-q4
		&END KIND
		&KIND O
			BASIS_SET DZVP-MOLOPT-SR-GTH
			POTENTIAL GTH-PBE-q6
		&END KIND
	&END SUBSYS
&END FORCE_EVAL
